# ===================================================================
#      AUTOPILOT COMMAND CENTER - ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------------
#  Copy this file to .env to get started.
#  Defaults work out of the box — just run: make up
# ===================================================================

# ------------------------------------------------------------
# BACKEND
# ------------------------------------------------------------
APP_ENV=development
FRONTEND_URL=http://localhost:3001
LOG_LEVEL=INFO

# Auth bypass — all requests auto-authenticated as Dev User (admin role)
AUTH_BYPASS=true

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=app_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------
# FRONTEND
# ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_BASE_PATH=

# NextAuth (required for session management even with AUTH_BYPASS)
NEXTAUTH_URL=http://localhost:3001
# Server-side calls happen INSIDE the container, which listens on 3000.
# Without this, next-auth's session fetch targets 3001 internally and
# fails with CLIENT_FETCH_ERROR (a red dev overlay, harmless but ugly).
NEXTAUTH_URL_INTERNAL=http://localhost:3000

# REQUIRED: A secret used to sign and encrypt NextAuth.js tokens.
# Generate with:
#   macOS/Linux: openssl rand -base64 32
#   Windows:     [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
NEXTAUTH_SECRET=

# ------------------------------------------------------------
# DOCKER
# ------------------------------------------------------------
# "dev" = hot reload | "prod" = optimized build
FRONTEND_TARGET=dev

# ------------------------------------------------------------
# RESOLVEFLOW AI — AGENT & INTEGRATIONS
# ------------------------------------------------------------
# Supervity Auto (backend only — never expose to the frontend)
SUPERVITY_API_BASE_URL=https://auto.supervity.ai
SUPERVITY_WORKFLOW_API_KEY=
SUPERVITY_WORKSPACE_ID=
SUPERVITY_ORCHESTRATOR_ID=
# Organisation key sent as the x-active-org header (your Auto workspace,
# e.g. the 'alpha' in auto.supervity.ai/u/alpha/...).
SUPERVITY_ORG_KEY=
SUPERVITY_TIMEOUT=30
SUPERVITY_MAX_RETRIES=3
# Trigger the Auto Orchestrator automatically when a run is created.
AUTO_TRIGGER_ON_RUN=true

# Public URL of THIS backend, so Auto can call the policy gate.
PUBLIC_BACKEND_URL=

# Supabase — system of record
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Slack — human escalation channel (#ticket-escalations)
SLACK_WEBHOOK_URL=

# Timeouts (seconds)
INTEGRATION_HTTP_TIMEOUT=8
SLACK_TIMEOUT=8
